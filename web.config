<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS 용 설정: .webp 그림을 내보내도록 등록 (없으면 IIS 가 webp 를 404 로 막음, 2026-11-06)
     서버 전체 설정에 .webp 가 이미 있으면 겹쳐서 500 오류가 나므로 remove 뒤 다시 등록한다 -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
